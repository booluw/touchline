# Backend process environment — for bare `go run ./cmd/*`, the migrate CLI,
# and integration tests. Copy to `backend/.env` (git-ignored).
# Keep values in sync with the repo-root `.env.example`, which drives
# Docker Compose and additionally carries frontend config.
#
# Postgres is EXTERNAL (Neon serverless):
#   - use the UNPOOLED endpoint (remove "-pooler" from the host),
#   - scheme must be `postgres://` (golang-migrate and river reject `postgresql://`),
#   - strip any surrounding quotes, e.g. if you paste from a shell or dashboard.

DATABASE_URL=postgres://<user>:<password>@ep-<project>-<region>.neon.tech/touchline?sslmode=require
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
API_PORT=8080
SCHEDULER_PORT=8081
WORKER_PORT=8082
ENV=development