# Share the Go build stage. Scheduler needs only the scheduler binary.
FROM golang:1.22-alpine AS builder
WORKDIR /app
COPY backend/go.mod backend/ ./
RUN go mod download
COPY backend/ ./
RUN go build -o /out/scheduler ./cmd/scheduler

FROM alpine:3.19
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /out/scheduler /usr/local/bin/scheduler
CMD ["scheduler"]