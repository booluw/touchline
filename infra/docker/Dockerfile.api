# Go backend (multi-stage build). The cmd/touchline binary runs the whole game
# in one process (serve) or a single subsystem (api | scheduler | worker).
FROM golang:1.25-alpine AS builder

WORKDIR /app

COPY backend/go.mod backend/ ./
RUN go mod download

COPY backend/ ./

# Build the single all-in-one binary (dev + default prod entry point).
RUN go build -o /out/touchline ./cmd/touchline

FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata

COPY --from=builder /out/touchline /usr/local/bin/touchline

EXPOSE 8080

# The container's default is the whole game in one process; override with
# ["touchline", "api"] / "scheduler" / "worker" for prod isolation.
CMD ["touchline", "serve"]