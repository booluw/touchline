# Touchline local development environment.
#
# Docker Compose reads this file automatically from the repo root when copied
# to `.env`. Fill in real values; the file is git-ignored.
#
# Postgres is EXTERNAL (Neon serverless) and is never a compose service:
#   - use the UNPOOLED endpoint (remove "-pooler" from the host),
#   - scheme must be `postgres://` (golang-migrate and river reject `postgresql://`),
#   - strip any surrounding quotes, e.g. if you paste from a shell or dashboard.
#
# For bare `go run ./cmd/*` or the migrate CLI (no Docker):
#   set -a; source .env; set +a
# (the backend template that mirrors this file is `backend/.env.example`)

DATABASE_URL=postgres://<user>:<password>@ep-<project>-<region>.neon.tech/touchline?sslmode=require
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
API_PORT=8080
SCHEDULER_PORT=8081
WORKER_PORT=8082
ENV=development

# Baked into the frontend client bundle at build time (Docker build arg).
NUXT_PUBLIC_API_BASE=http://localhost:8080